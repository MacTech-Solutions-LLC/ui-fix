{
  "manifest_version": 3,
  "name": "UI-Fix — Element Pinpoint",
  "version": "0.1.0",
  "description": "Pick any element on a page and file feedback / fix requests with a rich, reviewer-friendly element descriptor.",
  "action": {
    "default_title": "UI-Fix: pick an element (Alt+Shift+F)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "toggle-picker": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Toggle the element picker on the current page"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
